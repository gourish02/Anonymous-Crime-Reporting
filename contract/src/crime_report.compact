pragma language_version >= 0.20;

import CompactStandardLibrary;

// =============================================================================
// SafeCity — Multi-Module Public Safety Platform — Midnight Compact Contract
// =============================================================================
//
// 🏛️ MODULE 1: ANONYMOUS CRIME REPORTING & VERIFICATION
// 🎯 PRIVACY GOAL:
//   Proves a valid crime report exists on-chain without exposing reporter identity,
//   location, description, or raw evidence.
//
// 🔒 PRIVATE STATE (Witnesses — Local to Reporter's Device):
//   1. reporterIdentity  — Salted hash of reporter's wallet credentials.
//   2. crimeDescription  — Confidential narrative detailing the incident.
//   3. evidenceHash      — Cryptographic digest of confidential evidence.
//
// 🌐 PUBLIC STATE (Ledger — On-Chain & Shared):
//   1. reportId           — Sequence number minted via report_count.
//   2. verificationStatus — Pending (0), Verified (1), Rejected (2), Investigating (3).
//   3. timestamp          — Unix epoch submission timestamp.
//
// ─────────────────────────────────────────────────────────────────────────────
// 🎖️ MODULE 2: CONFIDENTIAL VOLUNTEER CREDENTIAL VERIFICATION
// 🎯 PRIVACY GOAL:
//   A volunteer proves they possess a valid, authentic, and active volunteer
//   credential WITHOUT ever exposing their private personal information.
//
// 🔒 PRIVATE STATE (Witnesses — Local to Volunteer's Device):
//   1. volunteerName      — Legal full name of the volunteer.
//   2. volunteerId        — Government or organizational volunteer identifier.
//   3. credentialHash     — Cryptographic hash/digest of credential documentation.
//   4. certificateNumber  — Professional license or certificate number.
//   5. address            — Residential physical address.
//   6. phoneNumber        — Personal contact phone number.
//   7. expiryDate         — Unix timestamp of credential expiration.
//
// 🌐 PUBLIC STATE (Ledger — On-Chain & Shared):
//   1. verificationStatus — Current verification state code:
//                           0 = NOT VERIFIED
//                           1 = VERIFIED
//                           2 = ACTIVE
//                           3 = EXPIRED
//   2. timestamp          — Unix timestamp of registration or verification.
//
// 🛡️ PRIVACY REQUIREMENTS:
//   The verification process MUST NEVER expose the private fields.
//   Circuits return strictly one of the four allowed verification states:
// ─────────────────────────────────────────────────────────────────────────────
// 🎂 MODULE 3: AGE ELIGIBILITY VERIFICATION (18+)
// 🎯 PRIVACY GOAL:
//   Prove that a user is at least 18 years old (age >= 18) before accessing
//   public safety reporting features WITHOUT exposing their actual age,
//   date of birth, government ID, or personal information.
//
// 🔒 PRIVATE STATE (Witnesses — Local to User's Device):
//   1. userAge           — Actual age in years (Uint<16>).
//   2. dateOfBirth       — Birth date timestamp (Uint<64>).
//   3. governmentIdHash  — Cryptographic hash of national identity document.
//   4. userSecretSalt    — Blinding salt for identity commitment.
//
// 🌐 PUBLIC STATE (Ledger — On-Chain & Shared):
//   1. eligibility_status — 0 = NOT ELIGIBLE, 1 = ELIGIBLE.
//   2. timestamp          — Unix timestamp of verification.
//
// 🛡️ PRIVACY REQUIREMENTS:
//   Never reveal:
//     • Actual age
//     • Date of birth
//     • Government ID
//     • Personal information
//   Only reveal:
//     • ELIGIBLE (1)
//     • NOT ELIGIBLE (0)
// =============================================================================

// ── Structs ──────────────────────────────────────────────────────────────────

/**
 * PublicReport (Module 1)
 *
 * Publicly verifiable record stored on the shared Midnight ledger.
 * Contains ONLY non-identifying metadata.
 * Zero personally identifiable information (PII) is present here.
 */
struct PublicReport {
  report_id:           Field,     // Public identifier (reportId)
  crime_type:          Uint<8>,   // Crime category code (0-7)
  timestamp:           Uint<64>,  // Public submission timestamp
  verification_status: Uint<8>,   // Verification status code (0=Pending, 1=Verified)
  verified:            Boolean,   // Boolean shorthand for verification status == 1
  upvotes:             Uint<32>,  // Community corroboration upvote count
  has_evidence:        Boolean    // Public flag indicating presence of private evidence
}

/**
 * VolunteerCredentialRecord (Module 2)
 *
 * Publicly verifiable record for a confidential volunteer credential.
 * Notice: Contains ONLY public state variables:
 *   - verification_status (VERIFIED / NOT VERIFIED / ACTIVE / EXPIRED)
 *   - timestamp
 * Zero private fields (Name, ID, Address, Cert No, Phone, Expiry) are included.
 */
struct VolunteerCredentialRecord {
  credential_id:       Field,     // Unique public credential identifier
  verification_status: Uint<8>,   // 0 = NOT VERIFIED, 1 = VERIFIED, 2 = ACTIVE, 3 = EXPIRED
  timestamp:           Uint<64>   // Public Unix timestamp of submission / verification
}

/**
 * VolunteerAttestation (Module 2 Commitment Record)
 * Public record binding commitment hash to binary selective disclosure outcomes.
 */
struct VolunteerAttestation {
  commitment:   Bytes<32>,  // Cryptographic commitment binding private credential fields
  attested_at:  Uint<64>,   // Public Unix timestamp of issuance / attestation
  is_verified:  Boolean,    // Verified (true) / Not Verified (false)
  is_active:    Boolean     // Certification Active (true) / Expired (false)
}

/**
 * AgeEligibilityRecord (Module 3)
 *
 * Publicly verifiable record for age eligibility verification.
 * Notice: Contains ONLY public state variables:
 *   - credential_id
 *   - eligibility_status: 1 (ELIGIBLE) or 0 (NOT ELIGIBLE)
 *   - is_eligible: Boolean
 *   - timestamp
 * Zero private fields (Actual age, Date of birth, Government ID, Personal info) are included.
 */
struct AgeEligibilityRecord {
  credential_id:      Field,     // Unique public credential identifier
  eligibility_status: Uint<8>,   // 0 = NOT ELIGIBLE, 1 = ELIGIBLE
  is_eligible:        Boolean,   // Boolean shorthand: true = ELIGIBLE, false = NOT ELIGIBLE
  timestamp:          Uint<64>   // Public Unix timestamp of verification
}

// ── Public State Variables (Ledger) ──────────────────────────────────────────

// ── Module 1: Crime Reporting Ledger State ──

/**
 * report_count
 * Auto-incrementing counter tracking total submitted reports.
 * Serves as the unique reportId generator.
 */
export ledger report_count: Counter;

/**
 * public_reports
 * Primary ledger key-value map from reportId (Field) -> PublicReport.
 * Accessible to any node on the Midnight network to query report verification status.
 */
export ledger public_reports: Map<Field, PublicReport>;

/**
 * verified_count
 * Aggregate counter tracking total reports successfully verified via ZK proofs.
 */
export ledger verified_count: Counter;

/**
 * type_counts
 * Per-category aggregation tracking report counts across each crime type code.
 */
export ledger type_counts: Map<Uint<8>, Uint<32>>;

// ── Module 2: Confidential Volunteer Verification Public State ──

/**
 * volunteer_credential_count
 * Auto-incrementing counter tracking total volunteer credentials submitted.
 */
export ledger volunteer_credential_count: Counter;

/**
 * volunteer_credential_records
 * Maps credential_id (Field) -> VolunteerCredentialRecord.
 * Stores only public verificationStatus and timestamp.
 */
export ledger volunteer_credential_records: Map<Field, VolunteerCredentialRecord>;

/**
 * verificationStatus (Public State)
 * Direct public ledger map from credential_id (Field) -> verificationStatus (Uint<8>):
 *   0 = NOT VERIFIED
 *   1 = VERIFIED
 *   2 = ACTIVE
 *   3 = EXPIRED
 */
export ledger volunteer_verification_status: Map<Field, Uint<8>>;

/**
 * timestamp (Public State)
 * Direct public ledger map from credential_id (Field) -> timestamp (Uint<64>).
 */
export ledger volunteer_timestamp: Map<Field, Uint<64>>;

/**
 * volunteer_count & active_volunteers_count (Aggregate Telemetry)
 */
export ledger volunteer_count: Counter;
export ledger active_volunteers_count: Counter;
export ledger volunteer_credentials: Map<Bytes<32>, VolunteerAttestation>;

// ── Module 3: Age Eligibility Verification Public State ──

/**
 * age_credential_count
 * Auto-incrementing counter tracking total age credential proofs submitted.
 */
export ledger age_credential_count: Counter;

/**
 * age_eligibility_records
 * Maps credential_id (Field) -> AgeEligibilityRecord.
 * Stores ONLY public verification status (ELIGIBLE / NOT ELIGIBLE) and timestamp.
 */
export ledger age_eligibility_records: Map<Field, AgeEligibilityRecord>;

/**
 * age_eligibility_status
 * Direct public ledger map from credential_id (Field) -> eligibility status code:
 *   0 = NOT ELIGIBLE (age < 18)
 *   1 = ELIGIBLE     (age >= 18)
 */
export ledger age_eligibility_status: Map<Field, Uint<8>>;

/**
 * age_timestamp
 * Direct public ledger map from credential_id (Field) -> Unix timestamp (Uint<64>).
 */
export ledger age_timestamp: Map<Field, Uint<64>>;

/**
 * eligible_users_count
 * Aggregate counter tracking total verified eligible users (age >= 18).
 */
export ledger eligible_users_count: Counter;

// ── Private State Variables (Witnesses) ───────────────────────────────────────
// These functions supply private witnesses during local ZK proof generation.
// Their return values NEVER leave the client's device and are NEVER stored
// in ledger state or transaction bodies.

// ── Module 1 Witnesses ──

/**
 * reporterIdentity
 * Private witness supplying the reporter's cryptographic identity commitment.
 * Ensures the reporter is an authenticated actor without publishing their address.
 */
witness reporterIdentity(): Bytes<32>;

/**
 * crimeDescription
 * Private witness supplying the sensitive crime description text.
 * Stays strictly on the submitter's client; evaluated inside the local ZK circuit.
 */
witness crimeDescription(): Bytes<128>;

/**
 * evidenceHash
 * Private witness supplying the hash of confidential evidence documents.
 * Proves possession of evidence without disclosing its content to the public.
 */
witness evidenceHash(): Bytes<32>;

// ── Module 2 Witnesses: Confidential Volunteer Verification ──
// All 7 private fields are evaluated strictly within local ZK witness memory.
// The verification process NEVER exposes any of these fields.

/**
 * 1. volunteerName
 * Private witness supplying the volunteer's legal name.
 * Stays strictly on the volunteer's device; never exposed on-chain.
 */
witness volunteerName(): Bytes<32>;

/**
 * 2. volunteerId
 * Private witness supplying government or organization ID.
 * Stays strictly on the volunteer's device; never exposed on-chain.
 */
witness volunteerId(): Bytes<32>;

/**
 * 3. credentialHash
 * Private witness supplying cryptographic digest of volunteer credential document.
 * Stays strictly on the volunteer's device; never exposed on-chain.
 */
witness credentialHash(): Bytes<32>;

/**
 * 4. certificateNumber
 * Private witness supplying professional certificate / license ID.
 * Stays strictly on the volunteer's device; never exposed on-chain.
 */
witness certificateNumber(): Bytes<32>;

/**
 * 5. address
 * Private witness supplying volunteer's residential physical address.
 * Stays strictly on the volunteer's device; never exposed on-chain.
 */
witness address(): Bytes<64>;

/**
 * 6. phoneNumber
 * Private witness supplying volunteer's phone contact information.
 * Stays strictly on the volunteer's device; never exposed on-chain.
 */
witness phoneNumber(): Bytes<32>;

/**
 * 7. expiryDate
 * Private witness supplying credential expiration timestamp (Unix milliseconds).
 * Evaluated inside local circuit to determine ACTIVE vs EXPIRED without leaking date.
 */
witness expiryDate(): Uint<64>;

// ── Module 3 Witnesses: Age Eligibility Verification ──
// These private witnesses supply the user's age credentials locally.
// They NEVER leave the user's device and are NEVER stored in ledger state.

/**
 * 1. userAge
 * Private witness supplying the user's actual age in years.
 * Evaluated strictly in local circuit memory to prove age >= 18.
 * NEVER exposed on-chain or revealed to observers.
 */
witness userAge(): Uint<16>;

/**
 * 2. dateOfBirth
 * Private witness supplying user's birth date timestamp.
 * Stays strictly on user's device; never exposed on-chain.
 */
witness dateOfBirth(): Uint<64>;

/**
 * 3. governmentIdHash
 * Private witness supplying cryptographic digest of user's national ID / driver's license.
 * Stays strictly on user's device; never exposed on-chain.
 */
witness governmentIdHash(): Bytes<32>;

/**
 * 4. userSecretSalt
 * Private witness providing blinding salt for identity commitment.
 * Stays strictly on user's device; never exposed on-chain.
 */
witness userSecretSalt(): Bytes<32>;

// =============================================================================
// MODULE 1 CIRCUITS: ANONYMOUS CRIME REPORTING
// =============================================================================

/**
 * 1. submitCrimeReport
 *
 * Submits a new crime report with zero-knowledge privacy guarantees:
 *   - Proves the submitter possesses a valid private reporterIdentity witness.
 *   - Proves the private crimeDescription and evidenceHash witnesses are non-empty.
 *   - Validates that crime_type is within accepted range [0, 7].
 *   - Validates that timestamp is non-zero.
 *   - Assigns a fresh, unique reportId on the public ledger.
 *   - Initializes verificationStatus to 0 (Pending).
 *
 * @param crime_type    Public categorization code (0-7).
 * @param timestamp     Public Unix timestamp of the submission.
 * @param has_evidence  Public boolean indicating whether evidence was provided.
 * @return              The newly generated unique reportId (Field).
 */
export circuit submitCrimeReport(
  crime_type:   Uint<8>,
  timestamp:    Uint<64>,
  has_evidence: Boolean
): Field {
  assert crime_type <= 7  "Invalid crime type category (must be 0-7)";
  assert timestamp  > 0   "Timestamp must be non-zero";

  const identityWitness: Bytes<32> = reporterIdentity();
  assert identityWitness != pad(32, "") "Reporter identity witness must not be empty";

  const descWitness: Bytes<128> = crimeDescription();
  assert descWitness != pad(128, "") "Crime description witness must not be empty";

  if (has_evidence) {
    const evWitness: Bytes<32> = evidenceHash();
    assert evWitness != pad(32, "") "Evidence hash witness must not be empty when has_evidence is true";
  }

  const id: Field = report_count as Field;

  const report: PublicReport = PublicReport {
    report_id:           id,
    crime_type:          crime_type,
    timestamp:           timestamp,
    verification_status: 0 as Uint<8>,    // Initial status: Pending
    verified:            false,
    upvotes:             0 as Uint<32>,
    has_evidence:        has_evidence
  };

  public_reports.insert(id, report);

  if (type_counts.member(crime_type)) {
    const prev: Uint<32> = type_counts.lookup(crime_type);
    type_counts.insert(crime_type, prev + 1 as Uint<32>);
  } else {
    type_counts.insert(crime_type, 1 as Uint<32>);
  }

  report_count.increment(1);

  return id;
}

/**
 * 2. verifyReport
 *
 * Verifies an existing report and updates its status to Verified (1).
 *
 * 🛡️ PRIVACY GOAL:
 *   Proves report validity on-chain without revealing who submitted it.
 *
 * @param report_id The unique identifier of the report to verify.
 * @return          True if the report was successfully transitioned to Verified.
 */
export circuit verifyReport(report_id: Field): Boolean {
  assert report_id < report_count as Field "Report ID does not exist on-chain";

  const r: PublicReport = public_reports.lookup(report_id);
  assert r.verification_status == 0 as Uint<8> "Report has already been verified or processed";

  public_reports.insert(report_id, PublicReport {
    report_id:           r.report_id,
    crime_type:          r.crime_type,
    timestamp:           r.timestamp,
    verification_status: 1 as Uint<8>,    // Updated status: Verified
    verified:            true,
    upvotes:             r.upvotes,
    has_evidence:        r.has_evidence
  });

  verified_count.increment(1);

  return true;
}

/**
 * 3. getReportStatus
 *
 * Read-only circuit returning the current verificationStatus of a report.
 *
 * @param report_id The unique identifier of the report to query.
 * @return          verification_status code (Uint<8>).
 */
export circuit getReportStatus(report_id: Field): Uint<8> {
  assert report_id < report_count as Field "Report ID does not exist on-chain";
  const r: PublicReport = public_reports.lookup(report_id);
  return r.verification_status;
}

/**
 * updateReportStatus
 *
 * Allows authorized administrators to transition report states:
 *   1 = Verified, 2 = Rejected, 3 = Under Investigation.
 *
 * @param report_id   Unique identifier of the target report.
 * @param new_status  Target status code (1, 2, or 3).
 */
export circuit updateReportStatus(
  report_id:  Field,
  new_status: Uint<8>
): [] {
  assert report_id < report_count as Field "Report ID does not exist on-chain";
  assert new_status >= 1 as Uint<8>        "Status 0 (Pending) is reserved for initial submission";
  assert new_status <= 3 as Uint<8>        "Invalid status code (must be 1, 2, or 3)";

  const r: PublicReport = public_reports.lookup(report_id);
  const is_verified: Boolean = new_status == 1 as Uint<8>;

  public_reports.insert(report_id, PublicReport {
    report_id:           r.report_id,
    crime_type:          r.crime_type,
    timestamp:           r.timestamp,
    verification_status: new_status,
    verified:            is_verified,
    upvotes:             r.upvotes,
    has_evidence:        r.has_evidence
  });

  if (is_verified && !r.verified) {
    verified_count.increment(1);
  }
}

/**
 * upvoteReport
 *
 * Community corroboration circuit incrementing endorsement count.
 *
 * @param report_id Unique identifier of the report to upvote.
 */
export circuit upvoteReport(report_id: Field): [] {
  assert report_id < report_count as Field "Report ID does not exist on-chain";
  const r: PublicReport = public_reports.lookup(report_id);

  public_reports.insert(report_id, PublicReport {
    report_id:           r.report_id,
    crime_type:          r.crime_type,
    timestamp:           r.timestamp,
    verification_status: r.verification_status,
    verified:            r.verified,
    upvotes:             r.upvotes + 1 as Uint<32>,
    has_evidence:        r.has_evidence
  });
}

// =============================================================================
// MODULE 2 CIRCUITS: CONFIDENTIAL VOLUNTEER CREDENTIAL VERIFICATION
// =============================================================================

/**
 * Circuit 1: submitVolunteerCredential
 *
 * Submits a volunteer credential for confidential verification.
 *
 * 🔒 PRIVACY GUARANTEE:
 *   Evaluates all 7 private state witnesses locally inside the client ZK prover:
 *     1. volunteerName
 *     2. volunteerId
 *     3. credentialHash
 *     4. certificateNumber
 *     5. address
 *     6. phoneNumber
 *     7. expiryDate
 *   None of these sensitive identifying attributes are EVER broadcasted to the
 *   network or stored in the on-chain ledger.
 *
 * 🌐 PUBLIC STATE WRITTEN:
 *   - verificationStatus: Set to VERIFIED (1) if valid, or EXPIRED (3) if past expiry
 *   - timestamp: Recorded as the public Unix attestation timestamp
 *
 * @param timestamp Public Unix timestamp of credential submission.
 * @return          Unique public credential_id assigned on-chain.
 */
export circuit submitVolunteerCredential(timestamp: Uint<64>): Field {
  assert timestamp > 0 "Submission timestamp must be positive";

  // 1. Evaluate private witnesses locally (never revealed)
  const name: Bytes<32>     = volunteerName();
  const id: Bytes<32>       = volunteerId();
  const credHash: Bytes<32> = credentialHash();
  const certNo: Bytes<32>   = certificateNumber();
  const addr: Bytes<64>     = address();
  const phone: Bytes<32>    = phoneNumber();
  const exp: Uint<64>       = expiryDate();

  // 2. Enforce cryptographic integrity constraints in zero knowledge
  assert name     != pad(32, "") "volunteerName private witness must not be empty";
  assert id       != pad(32, "") "volunteerId private witness must not be empty";
  assert credHash != pad(32, "") "credentialHash private witness must not be empty";
  assert certNo   != pad(32, "") "certificateNumber private witness must not be empty";
  assert addr     != pad(64, "") "address private witness must not be empty";
  assert phone    != pad(32, "") "phoneNumber private witness must not be empty";
  assert exp      > 0            "expiryDate private witness must be a valid positive timestamp";

  // 3. Assign unique public credential ID
  const cred_id: Field = volunteer_credential_count as Field;

  // 4. Initial verification status:
  // If already expired at submission time -> EXPIRED (3), otherwise VERIFIED (1)
  const initial_status: Uint<8> = if (exp < timestamp) {
    3 as Uint<8> // EXPIRED
  } else {
    1 as Uint<8> // VERIFIED
  };

  // 5. Update public state (Zero PII stored)
  volunteer_credential_records.insert(cred_id, VolunteerCredentialRecord {
    credential_id:       cred_id,
    verification_status: initial_status,
    timestamp:           timestamp
  });
  volunteer_verification_status.insert(cred_id, initial_status);
  volunteer_timestamp.insert(cred_id, timestamp);

  volunteer_credential_count.increment(1);

  return cred_id;
}

/**
 * Circuit 2: verifyVolunteerCredential
 *
 * Verifies an existing volunteer credential without exposing any private fields.
 *
 * 🔒 PRIVACY GUARANTEE:
 *   Evaluates certificate validity and performs the date comparison
 *   (expiryDate >= current_time) entirely within the zero-knowledge proof.
 *   The verifier and public observers learn ONLY the verification outcome:
 *     - VERIFIED (1)
 *     - NOT VERIFIED (0)
 *     - ACTIVE (2)
 *     - EXPIRED (3)
 *   Personal credentials (Name, ID, Address, Certificate No, Phone, Expiry)
 *   are NEVER exposed.
 *
 * 🌐 PUBLIC STATE UPDATED:
 *   - verificationStatus: Updated to ACTIVE (2) or EXPIRED (3)
 *   - timestamp: Updated to current_time
 *
 * @param credential_id Unique identifier of the credential to verify.
 * @param current_time  Current Unix timestamp against which to check active validity.
 * @return              Status code:
 *                        0 = NOT VERIFIED
 *                        1 = VERIFIED
 *                        2 = ACTIVE
 *                        3 = EXPIRED
 */
export circuit verifyVolunteerCredential(
  credential_id: Field,
  current_time:  Uint<64>
): Uint<8> {
  // Ensure credential exists on public ledger
  assert credential_id < volunteer_credential_count as Field "Volunteer credential does not exist on-chain";
  assert current_time > 0                                    "Current timestamp must be positive";

  // Evaluate private witnesses locally in ZK
  const name: Bytes<32>     = volunteerName();
  const id: Bytes<32>       = volunteerId();
  const credHash: Bytes<32> = credentialHash();
  const certNo: Bytes<32>   = certificateNumber();
  const addr: Bytes<64>     = address();
  const phone: Bytes<32>    = phoneNumber();
  const exp: Uint<64>       = expiryDate();

  // Validate integrity of private witnesses
  assert name     != pad(32, "") "volunteerName private witness must not be empty";
  assert id       != pad(32, "") "volunteerId private witness must not be empty";
  assert credHash != pad(32, "") "credentialHash private witness must not be empty";
  assert certNo   != pad(32, "") "certificateNumber private witness must not be empty";
  assert addr     != pad(64, "") "address private witness must not be empty";
  assert phone    != pad(32, "") "phoneNumber private witness must not be empty";

  // Evaluate ACTIVE vs EXPIRED in zero knowledge:
  // If exp >= current_time -> ACTIVE (2), else EXPIRED (3)
  const status: Uint<8> = if (exp >= current_time) {
    2 as Uint<8> // ACTIVE
  } else {
    3 as Uint<8> // EXPIRED
  };

  // Update public ledger state
  volunteer_credential_records.insert(credential_id, VolunteerCredentialRecord {
    credential_id:       credential_id,
    verification_status: status,
    timestamp:           current_time
  });
  volunteer_verification_status.insert(credential_id, status);
  volunteer_timestamp.insert(credential_id, current_time);

  return status;
}

/**
 * Circuit 3: getVerificationStatus
 *
 * Read-only circuit returning the current verification status of a volunteer credential.
 *
 * 🔒 PRIVACY GUARANTEE:
 *   Enables coordinators, emergency dispatchers, and public verifiers to verify
 *   volunteer credentials in O(1) time without possessing or requesting any private
 *   volunteer data.
 *
 * 🎯 RETURN VALUES:
 *   Returns ONLY one of the four protocol verification states:
 *     - 0: NOT VERIFIED
 *     - 1: VERIFIED
 *     - 2: ACTIVE
 *     - 3: EXPIRED
 *
 * @param credential_id Unique identifier of the credential being queried.
 * @return              Status code (Uint<8>): 0 = NOT VERIFIED, 1 = VERIFIED, 2 = ACTIVE, 3 = EXPIRED.
 */
export circuit getVerificationStatus(credential_id: Field): Uint<8> {
  assert credential_id < volunteer_credential_count as Field "Volunteer credential does not exist on-chain";
  return volunteer_verification_status.lookup(credential_id);
}

// ── Commitment-Based Selective Disclosure Circuits ───────────────────────────

/**
 * registerVolunteerCredential (Commitment Mode)
 * Registers an attested volunteer credential commitment on-chain.
 */
export circuit registerVolunteerCredential(
  commitment:  Bytes<32>,
  attested_at: Uint<64>
): Bytes<32> {
  assert commitment != pad(32, "") "Volunteer commitment must not be empty";
  assert attested_at > 0           "Attestation timestamp must be positive";

  const nameWitness: Bytes<32>    = volunteerName();
  const idWitness: Bytes<32>      = volunteerId();
  const addrWitness: Bytes<64>    = address();
  const certWitness: Bytes<32>    = certificateNumber();
  const contactWitness: Bytes<32> = phoneNumber();
  const expWitness: Uint<64>      = expiryDate();

  assert nameWitness != pad(32, "")    "Volunteer name witness must not be empty";
  assert idWitness != pad(32, "")      "Volunteer ID witness must not be empty";
  assert addrWitness != pad(64, "")    "Volunteer address witness must not be empty";
  assert certWitness != pad(32, "")    "Certificate number witness must not be empty";
  assert contactWitness != pad(32, "") "Contact info witness must not be empty";

  const is_active: Boolean = expWitness >= attested_at;

  volunteer_credentials.insert(commitment, VolunteerAttestation {
    commitment:  commitment,
    attested_at: attested_at,
    is_verified: true,
    is_active:   is_active
  });

  volunteer_count.increment(1);
  if (is_active) {
    active_volunteers_count.increment(1);
  }

  return commitment;
}

/**
 * proveVolunteerEligibility (Commitment Mode)
 * Evaluates selective disclosure: Verified/Not Verified and Active/Expired.
 */
export circuit proveVolunteerEligibility(
  commitment:   Bytes<32>,
  current_time: Uint<64>
): Boolean {
  assert volunteer_credentials.member(commitment) "Volunteer credential commitment not found on-chain";

  const nameWitness: Bytes<32>    = volunteerName();
  const idWitness: Bytes<32>      = volunteerId();
  const addrWitness: Bytes<64>    = address();
  const certWitness: Bytes<32>    = certificateNumber();
  const contactWitness: Bytes<32> = phoneNumber();
  const expWitness: Uint<64>      = expiryDate();

  assert nameWitness != pad(32, "")    "Volunteer name witness must not be empty";
  assert idWitness != pad(32, "")      "Volunteer ID witness must not be empty";
  assert addrWitness != pad(64, "")    "Volunteer address witness must not be empty";
  assert certWitness != pad(32, "")    "Certificate number witness must not be empty";
  assert contactWitness != pad(32, "") "Contact info witness must not be empty";

  const is_active: Boolean = expWitness >= current_time;
  const prev: VolunteerAttestation = volunteer_credentials.lookup(commitment);

  volunteer_credentials.insert(commitment, VolunteerAttestation {
    commitment:  prev.commitment,
    attested_at: prev.attested_at,
    is_verified: true,
    is_active:   is_active
  });

  return is_active;
}

/**
 * getVolunteerStatus (Commitment Mode)
 * Read-only circuit to inspect whether a volunteer commitment is Verified & Active.
 */
export circuit getVolunteerStatus(commitment: Bytes<32>): Boolean {
  assert volunteer_credentials.member(commitment) "Volunteer credential commitment not found on-chain";
  const att: VolunteerAttestation = volunteer_credentials.lookup(commitment);
  return att.is_verified && att.is_active;
}

// =============================================================================
// MODULE 3 CIRCUITS: AGE ELIGIBILITY VERIFICATION (18+)
// =============================================================================
//
// 🎯 PRIVACY GOAL:
//   Prove that a user is at least 18 years old (age >= 18) before accessing
//   public safety reporting features WITHOUT exposing actual age, date of birth,
//   government ID, or personal information.
//
// 🔒 PRIVACY REQUIREMENTS:
//   Never reveal:
//     - Actual age
//     - Date of birth
//     - Government ID
//     - Personal information
//   Only reveal:
//     - ELIGIBLE (1)
//     - NOT ELIGIBLE (0)
// =============================================================================

/**
 * Circuit 1: submitAgeCredential
 *
 * Submits an age verification proof using private witnesses.
 * Proves in zero-knowledge whether age >= 18 without revealing actual age.
 *
 * 🔒 PRIVACY GUARANTEE:
 *   Evaluates userAge() >= 18 in zero-knowledge. The actual age and personal data
 *   are discarded immediately after constraint checking and NEVER stored on-chain.
 *
 * 🌐 PUBLIC STATE WRITTEN:
 *   - eligibility_status: 1 (ELIGIBLE) or 0 (NOT ELIGIBLE)
 *   - timestamp: Public Unix timestamp
 *
 * @param timestamp Public Unix timestamp of age verification submission.
 * @return          Unique public credential_id assigned on-chain.
 */
export circuit submitAgeCredential(timestamp: Uint<64>): Field {
  assert timestamp > 0 "Submission timestamp must be positive";

  // 1. Evaluate private witnesses locally in zero-knowledge (never revealed)
  const age: Uint<16>          = userAge();
  const dob: Uint<64>          = dateOfBirth();
  const govId: Bytes<32>       = governmentIdHash();
  const salt: Bytes<32>        = userSecretSalt();

  // 2. Validate cryptographic integrity constraints
  assert govId != pad(32, "") "governmentIdHash witness must not be empty";
  assert salt  != pad(32, "") "userSecretSalt witness must not be empty";
  assert dob   > 0            "dateOfBirth witness must be positive";

  // 3. Evaluate verification logic in zero knowledge: age >= 18
  const is_eligible: Boolean = age >= 18;

  // 4. Determine public eligibility status:
  //    0 = NOT ELIGIBLE, 1 = ELIGIBLE
  const status: Uint<8> = if (is_eligible) {
    1 as Uint<8> // ELIGIBLE
  } else {
    0 as Uint<8> // NOT ELIGIBLE
  };

  // 5. Assign unique public credential ID
  const cred_id: Field = age_credential_count as Field;

  // 6. Update public state (Zero PII stored: no age, no DOB, no ID)
  age_eligibility_records.insert(cred_id, AgeEligibilityRecord {
    credential_id:      cred_id,
    eligibility_status: status,
    is_eligible:        is_eligible,
    timestamp:          timestamp
  });
  age_eligibility_status.insert(cred_id, status);
  age_timestamp.insert(cred_id, timestamp);

  age_credential_count.increment(1);
  if (is_eligible) {
    eligible_users_count.increment(1);
  }

  return cred_id;
}

/**
 * Circuit 2: verifyAgeEligibility
 *
 * Verifies the age eligibility of an existing credential record in zero knowledge.
 *
 * 🔒 PRIVACY GUARANTEE:
 *   Evaluates the constraint (age >= 18) entirely within the zero-knowledge proof.
 *   The verifier and public observers learn ONLY the binary eligibility outcome:
 *     - 1 = ELIGIBLE
 *     - 0 = NOT ELIGIBLE
 *   Actual age, date of birth, and identity are NEVER exposed.
 *
 * @param credential_id Unique identifier of the age credential.
 * @param current_time  Current Unix timestamp.
 * @return              Eligibility status code (1 = ELIGIBLE, 0 = NOT ELIGIBLE).
 */
export circuit verifyAgeEligibility(credential_id: Field, current_time: Uint<64>): Uint<8> {
  assert current_time > 0 "Current timestamp must be positive";
  assert credential_id < age_credential_count as Field "Age credential does not exist on-chain";

  const age: Uint<16> = userAge();
  const is_eligible: Boolean = age >= 18;

  const status: Uint<8> = if (is_eligible) {
    1 as Uint<8> // ELIGIBLE
  } else {
    0 as Uint<8> // NOT ELIGIBLE
  };

  age_eligibility_records.insert(credential_id, AgeEligibilityRecord {
    credential_id:      credential_id,
    eligibility_status: status,
    is_eligible:        is_eligible,
    timestamp:          current_time
  });
  age_eligibility_status.insert(credential_id, status);
  age_timestamp.insert(credential_id, current_time);

  return status;
}

/**
 * Circuit 3: getEligibilityStatus
 *
 * Read-only circuit returning the public eligibility status of an age credential.
 *
 * 🎯 RETURN VALUES:
 *   Returns ONLY one of two states:
 *     - 0: NOT ELIGIBLE
 *     - 1: ELIGIBLE
 *
 * @param credential_id Unique identifier of the credential being queried.
 * @return              Status code (Uint<8>): 0 = NOT ELIGIBLE, 1 = ELIGIBLE.
 */
export circuit getEligibilityStatus(credential_id: Field): Uint<8> {
  assert credential_id < age_credential_count as Field "Age credential does not exist on-chain";
  return age_eligibility_status.lookup(credential_id);
}
