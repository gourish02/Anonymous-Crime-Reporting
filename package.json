{
  "name": "anonymous-crime-reporting-dapp",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest run src/",
    "test:watch": "vitest src/",
    "test:contract": "node contract/test/crime_report.contract-test.mjs",
    "test:all": "vitest run src/ && node contract/test/crime_report.contract-test.mjs && npm run ai:test",
    "ai:train": "python backend/train.py",
    "ai:test": "python backend/test_classifier.py && python backend/test_api.py",
    "ai:server": "python backend/run.py"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1",
    "react-hot-toast": "^2.4.1",
    "framer-motion": "^11.3.24",
    "lucide-react": "^0.427.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "typescript": "^5.2.2",
    "vite": "^5.3.4",
    "vitest": "^2.0.5"
  }
}
