# =============================================================================
# SafeCity / Anonymous Crime Reporting DApp — Environment Configuration Example
# Copy this file to .env and fill in values for your environment.
# =============================================================================

# ── Frontend Configuration ───────────────────────────────────────────────────

# Active Midnight network: 'preprod' | 'devnet' | 'mainnet'
VITE_MIDNIGHT_NETWORK=preprod

# Midnight Preprod Testnet Contract Address
# Leave blank (falls back to "NOT_CONFIGURED" local ZK simulation) until on-chain deployment.
# Once deployed following docs/DEPLOYMENT_CHECKLIST.md, paste the 64-char hex address here.
#
# NOTE FOR VERCEL & CI/CD DEPLOYMENTS:
# Use standard Vercel environment variables (Settings > Environment Variables).
# Do NOT use deprecated Vercel Secret references (@secret_name) in vercel.json.
#
# Fallback support is built-in:
#   const contractAddress =
#     import.meta.env.VITE_CONTRACT_ADDRESS_PREPROD ||
#     "NOT_CONFIGURED";
# If this variable is omitted or empty at build time, the application falls back
# to "NOT_CONFIGURED" with user-friendly status banners without failing the build.
VITE_CONTRACT_ADDRESS_PREPROD=

# Midnight Local DevNet Contract Address (if testing with local DevNet node)
VITE_CONTRACT_ADDRESS_DEVNET=

# Fast-API AI Crime Classifier Service Endpoint
VITE_AI_SERVICE_URL=http://localhost:8000

# ── Midnight Network Infrastructure (Preprod Defaults) ────────────────────────
# Uncomment to override default network gateways:
# VITE_RPC_URI_PREPROD=https://rpc.testnet-02.midnight.network
# VITE_INDEXER_URI_PREPROD=https://indexer.testnet-02.midnight.network/api/v1/graphql
# VITE_PROOF_SERVER_URI=https://proof-server.testnet-02.midnight.network

# ── Local DevNet Infrastructure (Optional) ────────────────────────────────────
# VITE_DEVNET_RPC_URI=http://localhost:9944
# VITE_DEVNET_INDEXER_URI=http://localhost:8088/api/v1/graphql
# VITE_DEVNET_PROOF_SERVER_URI=http://localhost:6300

# ── AI Service Configuration (Python Backend) ─────────────────────────────────
PORT=8000
HOST=0.0.0.0
