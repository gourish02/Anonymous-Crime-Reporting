# =============================================================================
# Anonymous Crime Reporting DApp — Environment Configuration Example
# Copy this file to .env and fill in values for your environment.
# =============================================================================

# ── Frontend Configuration ───────────────────────────────────────────────────

# Active Midnight network: 'preprod' | 'devnet' | 'mainnet'
VITE_MIDNIGHT_NETWORK=preprod

# Midnight Preprod Testnet Contract Address
# Active Deployed Contract: 0200fd03c98cb6cccd46085adb1f1bfc68841d3725bd6cbecf0d265f94099a0e
VITE_CONTRACT_ADDRESS_PREPROD=0200fd03c98cb6cccd46085adb1f1bfc68841d3725bd6cbecf0d265f94099a0e

# Midnight Local DevNet Contract Address (if testing locally)
VITE_CONTRACT_ADDRESS_DEVNET=

# Fast-API AI Crime Classifier Service Endpoint
VITE_AI_SERVICE_URL=http://localhost:8000

# ── Midnight Network Infrastructure (Preprod Defaults) ────────────────────────
# Uncomment to override default network gateways:
# VITE_RPC_URI_PREPROD=https://rpc.testnet-02.midnight.network
# VITE_INDEXER_URI_PREPROD=https://indexer.testnet-02.midnight.network/api/v1/graphql
# VITE_PROOF_SERVER_URI=https://proof-server.testnet-02.midnight.network

# ── Local DevNet Infrastructure (Optional) ────────────────────────────────────
# VITE_DEVNET_RPC_URI=http://localhost:9944
# VITE_DEVNET_INDEXER_URI=http://localhost:8088/api/v1/graphql
# VITE_DEVNET_PROOF_SERVER_URI=http://localhost:6300

# ── AI Service Configuration (Python Backend) ─────────────────────────────────
PORT=8000
HOST=0.0.0.0
